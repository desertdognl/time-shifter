{
    "manifest_version": 3,
    "name": "Time Shifter",
    "version": "1.0.15",
    "description": "Adjusts the browser's internal clock by a custom offset. Useful for time-sensitive features.",
    "permissions": [
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_title": "Time Shifter"
    },
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "background": {
      "service_worker": "background.js"
    }
  }